<section id="smaken" class="flavours"><div class="wrap"><span class="eyebrow">DRIE IDEEËN. NUL SAAIE NAMEN.</span><h2>{{ section.settings.heading | escape }}</h2><p>Conceptsmaken. Recepten, ingrediënten en voedingswaarden volgen na bevestiging.</p><div class="cards">{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><div class="card-art">{% render 'pack' %}</div><span class="tag">SMAAKCONCEPT</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p><p class="small">Prijs en voedingsinformatie: nog te bepalen.</p></article>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Flavours",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "KIES JE KARAKTER."
    }
  ],
  "blocks": [
    {
      "type": "flavour",
      "name": "Smaakconcept",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Naam",
          "default": "Smaakconcept"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Omschrijving",
          "default": "Recept nog in ontwikkeling."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Flavours"
    }
  ]
}
{% endschema %}
