<section class="hero wrap"><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.copy | escape }}</p><a class="button" href="#smaken">Ontdek de concepten ↗</a><p class="small">Prelaunch • Nog niet te bestellen</p></div><div class="hero-art">{% render 'pack' %}<span class="stamp">WE HEBBEN<br>NOTEN.<br>EN PLANNEN.</span></div></section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Bovenkop",
      "default": "EEN REEP MET EEN GROTE MOND."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "PAK EEN REEP. GEEN EXCUUS."
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Tekst",
      "default": "We werken aan drie smaken. De attitude is alvast af. De rest doen we liever goed."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
